{
  "request": {
    "method": "POST",
    "url": "/pagamentos",
    "bodyPatterns": [
      {
        "matchesJsonPath": {
          "expression": "$.codigo_seguranca",
          "equalTo": "111"
        }
      }
    ]
  },
  "response": {
    "status": 201,
    "headers": {
      "Content-Type": "application/json; charset=utf-8"
    },
    "jsonBody": {
      "status": "APROVADO",
      "mensagem": "Pagamento aprovado"
    }
  }
}
